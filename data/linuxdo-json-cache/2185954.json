lse,"admin":false,"staff":false,"user_id":330364,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"mentioned_users":[],"post_url":"/t/topic/2185954/5","locale":null,"is_localized":false,"animated_avatar":null,"can_assign":false,"boosts":[],"can_boost":true,"user_cakedate":"2026-03-13","event":null,"category_expert_approved_group":null,"needs_category_expert_approval":null,"can_manage_category_expert_posts":false,"reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"user_signature":null,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":17900332,"name":"浅风","username":"QianFuv","avatar_template":"/user_avatar/linux.do/qianfuv/{size}/1467486_2.png","created_at":"2026-05-16T05:15:57.628Z","cooked":"\u003cp\u003e曾经用 opus4.6 规划 + gpt5.4 编码，还不错 但是 gpt5.5 出来之后就把工作全部交给他了 我转而去做任务的约束（自定义 plan 模板等等，算是一个简易版的 tdd），以此来约束 gpt5.5 的规划和编码整个流程\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":7,"updated_at":"2026-05-16T05:15:57.628Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":77,"readers_count":76,"score":20.0,"yours":false,"topic_id":2185954,"topic_slug":"topic","display_username":"浅风","primary_group_name":null,"flair_name":"g-s-research","flair_url":"https://cdn3.ldstatic.com/original/4X/7/5/9/7591f23cdb46385750421a70cd227c771ede9f34.gif","flair_bg_color":"8da0cbbb","flair_color":"ffffff","flair_group_id":95,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":false,"user_title":"骐骥驰骋","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"can_act":true},{"id":6,"can_act":true},{"id":3,"can_act":true},{"id":4,"can_act":true},{"id":8,"can_act":true},{"id":1003,"can_act":true},{"id":1002,"can_act":true},{"id":1001,"can_act":true},{"id":10,"can_act":true},{"id":7,"can_act":true}],"moderator":false,"admin":false,"staff":false,"user_id":311070,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"mentioned_users":[],"post_url":"/t/topic/2185954/6","locale":null,"is_localized":false,"animated_avatar":null,"can_assign":false,"boosts":[],"can_boost":true,"user_cakedate":"2026-01-28","user_birthdate":"1904-09-21","event":null,"category_expert_approved_group":null,"needs_category_expert_approval":null,"can_manage_category_expert_posts":false,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"user_signature":null,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":17931792,"name":null,"username":"laris","avatar_template":"/user_avatar/linux.do/laris/{size}/725500_2.png","created_at":"2026-05-17T08:10:19.344Z","cooked":"\u003cp\u003e我一直没实践过多模型混合编程。\u003cbr\u003e\n一般我有一个想法或者主意，目前成熟的思路是：\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e想让opus做调研，deep research，有源代码最好，网上搜，或者IDA RE，每个参考一个深度分析\u003c/li\u003e\n\u003cli\u003e告诉他我的想法诉求，然后参考上述深度调研，大概按照SPEC的思路来设计架构，流程图，实现框架，单测和在线测试，review一边，如果哪里觉得需要调整就讨论修改\u003c/li\u003e\n\u003cli\u003e开始干，剩下就不用管了\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e在第2的时候，不同的IDE会表现不同，比如cursor会有一个plan mode会问一下方向性选择，ZED也有plan mode。但是基本都是像楼上说的方向性，约束，是需要人来判断定性。\u003c/p\u003e\n\u003cp\u003e所以现在我最头疼的是，LLM并没有你的profile，不知道你的品味和选择倾向性，如何做到高层次的指导变得更全自动化，是一个问题。现在很多时候LLM最后问的问题我自己都不知道，他跑了很久然后生成一个阶段文档，可能触及我的知识盲区了，我就完全不知道该怎么指导了。\u003c/p\u003e\n\u003cp\u003e反正最近很迷茫，还没完全想明白以后要怎么弄。\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":7,"updated_at":"2026-05-17T08:10:19.344Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":40,"readers_count":39,"score":37.6,"yours":false,"topic_id":2185954,"topic_slug":"topic","display_user